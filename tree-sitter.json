{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "usl",
      "camelcase": "Usl",
      "title": "USL",
      "scope": "source.usl",
      "file-types": [
        "usl"
      ],
      "injection-regex": "^usl$",
      "class-name": "TreeSitterUsl"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Usl grammar for tree-sitter",
    "authors": [
      {
        "name": "wearr",
        "email": "contact@wearr.dev",
        "url": "https://wearr.dev/"
      }
    ],
    "links": {
      "repository": "https://github.com/wearrrrr/tree-sitter-usl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}